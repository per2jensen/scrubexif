              },
              "properties": {
                "purls": [
                  "pkg:deb/ubuntu/libjpeg-turbo-progs@2.1.5-2ubuntu2?arch=amd64\u0026distro=ubuntu-24.04\u0026upstream=libjpeg-turbo"
                ],
                "security-severity": "6.5"
              }
