            {
              "id": "CVE-2026-4046-libc-bin",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-4046 medium vulnerability for libc-bin package"
              },
              "fullDescription": {
                "text": "The iconv() function in the GNU C Library versions 2.43 and earlier may crash due to an assertion failure when converting inputs from the IBM1390 or IBM1399 character sets, which may be used to remotely crash an application.\n\n\n\nThis vulnerability can be trivially mitigated by removing the IBM1390 and IBM1399 character sets from systems that do not need them."
              },
              "helpUri": "https://ubuntu.com/security/CVE-2026-4046",
              "help": {
                "text": "Vulnerability CVE-2026-4046\nSeverity: medium\nPackage: libc-bin\nVersion: 2.39-0ubuntu8.7\nFix Version: 2.39-0ubuntu8.8\nType: deb\nLocation: \nData Namespace: ubuntu:distro:ubuntu:24.04\nLink: [CVE-2026-4046](https://ubuntu.com/security/CVE-2026-4046)",
