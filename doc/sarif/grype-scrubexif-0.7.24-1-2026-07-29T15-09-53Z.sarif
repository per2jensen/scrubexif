{
  "version": "2.1.0",
  "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/errata01/os/schemas/sarif-schema-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "grype",
          "version": "0.116.1",
          "informationUri": "https://github.com/anchore/grype",
          "rules": [
            {
              "id": "CVE-2025-59375-libexpat1",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2025-59375 medium vulnerability for libexpat1 package"
              },
              "fullDescription": {
                "text": "libexpat in Expat before 2.7.2 allows attackers to trigger large dynamic memory allocations via a small document that is submitted for parsing."
              },
              "helpUri": "https://ubuntu.com/security/CVE-2025-59375",
              "help": {
                "text": "Vulnerability CVE-2025-59375\nSeverity: medium\nPackage: libexpat1\nVersion: 2.6.1-2ubuntu0.4\nFix Version: \nType: deb\nLocation: \nData Namespace: ubuntu:distro:ubuntu:24.04\nLink: [CVE-2025-59375](https://ubuntu.com/security/CVE-2025-59375)",
                "markdown": "**Vulnerability CVE-2025-59375**\n| Severity | Package | Version | Fix Version | Type | Location | Data Namespace | Link |\n| --- | --- | --- | --- | --- | --- | --- | --- |\n| medium  | libexpat1  | 2.6.1-2ubuntu0.4  |   | deb  |   | ubuntu:distro:ubuntu:24.04  | [CVE-2025-59375](https://ubuntu.com/security/CVE-2025-59375)  |\n"
              },
              "properties": {
                "purls": [
                  "pkg:deb/ubuntu/libexpat1@2.6.1-2ubuntu0.4?arch=amd64\u0026distro=ubuntu-24.04\u0026upstream=expat"
                ],
                "security-severity": "7.5"
              }
            },
            {
              "id": "CVE-2018-10126-libjpeg-turbo-progs",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2018-10126 low vulnerability for libjpeg-turbo-progs package"
              },
              "fullDescription": {
                "text": "ijg-libjpeg before 9d, as used in tiff2pdf (from LibTIFF) and other products, does not check for a NULL pointer at a certain place in jpeg_fdct_16x16 in jfdctint.c."
              },
              "helpUri": "https://ubuntu.com/security/CVE-2018-10126",
              "help": {
                "text": "Vulnerability CVE-2018-10126\nSeverity: low\nPackage: libjpeg-turbo-progs\nVersion: 2.1.5-2ubuntu2\nFix Version: \nType: deb\nLocation: \nData Namespace: ubuntu:distro:ubuntu:24.04\nLink: [CVE-2018-10126](https://ubuntu.com/security/CVE-2018-10126)",
