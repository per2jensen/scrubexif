            {
              "id": "CVE-2026-51296-libsqlite3-0",
              "name": "DpkgMatcherExactIndirectMatch",
              "shortDescription": {
                "text": "CVE-2026-51296 medium vulnerability for libsqlite3-0 package"
              },
              "fullDescription": {
                "text": "SQLite 3.41 has a use-after-free vulnerability in jsonRemoveFunc of SQLite JSON module. The parsed JSON object is freed at line 3555, while line 3575 still calls jsonLookupStep with the released pointer. Remote attackers can exploit this flaw to crash the service and leak heap memory information."
              },
              "helpUri": "https://ubuntu.com/security/CVE-2026-51296",
