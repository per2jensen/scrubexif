                ],
                "security-severity": "9.8"
              }
            },
            {
              "id": "CVE-2026-5704-tar",
              "name": "DpkgMatcherExactDirectMatch",
              "shortDescription": {
                "text": "CVE-2026-5704 medium vulnerability for tar package"
              },
              "fullDescription": {
                "text": "A flaw was found in tar. A remote attacker could exploit this vulnerability by crafting a malicious archive, leading to hidden file injection with fully attacker-controlled content. This bypasses pre-extraction inspection mechanisms, potentially allowing an attacker to introduce malicious files onto a system without detection."
              },
              "helpUri": "https://ubuntu.com/security/CVE-2026-5704",
              "help": {
                "text": "Vulnerability CVE-2026-5704\nSeverity: medium\nPackage: tar\nVersion: 1.35+dfsg-3build1\nFix Version: 1.35+dfsg-3ubuntu0.4\nType: deb\nLocation: \nData Namespace: ubuntu:distro:ubuntu:24.04\nLink: [CVE-2026-5704](https://ubuntu.com/security/CVE-2026-5704)",
